rules_version = '2';

// TKPrints — reglas de Firestore
//
// ╔══════════════════════════════════════════════════════════════════════╗
// ║  ESTE ARCHIVO NO SE DESPLIEGA SOLO.                                  ║
// ║                                                                      ║
// ║  Mergear a main NO lo aplica: no hay CI que lo despliegue. Mientras  ║
// ║  no corras el deploy, Firestore sigue usando las reglas viejas y el  ║
// ║  backoffice falla con "Missing or insufficient permissions".         ║
// ║                                                                      ║
// ║      npm run deploy:rules                                            ║
// ║                                                                      ║
// ║  (equivale a: npx firebase-tools deploy --only firestore:rules)      ║
// ║  Requiere haber corrido antes `npx firebase-tools login`.            ║
// ║  Alternativa sin CLI: consola de Firebase → Firestore Database →     ║
// ║  pestaña Rules → pegar este archivo → Publish.                       ║
// ╚══════════════════════════════════════════════════════════════════════╝
//
// Modelo de roles: /users/{uid}.role == "admin".
// El catálogo público solo necesita leer "products" y "categories".
// El inventario de filamento y los pedidos son 100% privados del backoffice.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaLogueado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Usuarios ───────────────────────────────────────────────────────
    // Cada usuario lee su propio documento (App.jsx consulta su rol).
    // Nadie puede auto-asignarse el rol admin: solo un admin cambia roles.
    match /users/{userId} {
      allow read: if estaLogueado() && (request.auth.uid == userId || esAdmin());
      allow create: if estaLogueado()
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if esAdmin()
        || (estaLogueado() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role);
      allow delete: if esAdmin();
    }

    // ── Catálogo público ───────────────────────────────────────────────
    // Lectura abierta (incluye el booleano "disponible", que es el único
    // dato de stock que ve el público). Escritura solo admin.
    //
    // Las reglas NO se heredan hacia las subcolecciones: products/{id}/privado
    // queda cubierto exclusivamente por su propio match de abajo, así que la
    // lectura pública de acá no lo alcanza.
    match /products/{productId} {
      allow read: if true;
      allow write: if esAdmin();

      // receta, origenUrl y notas: ni lectura ni escritura pública.
      match /privado/{docId} {
        allow read, write: if esAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Consulta de collection group sobre "privado": el backoffice trae las
    // recetas de todo el catálogo en una sola lectura. Firestore NO habilita
    // collection group con el match anidado de arriba, hace falta este match
    // con comodín recursivo. Sigue siendo admin-only.
    match /{path=**}/privado/{docId} {
      allow read: if esAdmin();
    }

    // ── Configuración de costos (backoffice) ───────────────────────────
    match /settings/{settingId} {
      allow read, write: if esAdmin();
    }

    // ── Inventario de filamento ────────────────────────────────────────
    // Sin lectura ni escritura pública: las cantidades en gramos y los
    // historiales de gastos/restocks nunca salen del backoffice.
    match /filamentos/{filamentoId} {
      allow read, write: if esAdmin();

      match /gastos/{gastoId} {
        allow read, write: if esAdmin();
      }

      match /restocks/{restockId} {
        allow read, write: if esAdmin();
      }
    }

    // ── Personalizados ─────────────────────────────────────────────────
    // Piezas a pedido de un cliente puntual. A diferencia de "products",
    // NO son de lectura pública: nunca salen al catálogo. Llevan el mismo
    // esquema de datos privados (receta, insumos, origen, notas) en su
    // subcolección, que no hereda la regla del padre.
    match /personalizados/{personalizadoId} {
      allow read, write: if esAdmin();

      match /privado/{docId} {
        allow read, write: if esAdmin();
      }
    }

    // ── Catálogo de insumos ────────────────────────────────────────────
    // Imanes, tornillos, LEDs: precios de costo y stock interno. Igual que
    // filamentos, sin lectura ni escritura pública, con los mismos dos
    // historiales en subcolecciones (que NO heredan la regla del padre).
    match /insumos/{insumoId} {
      allow read, write: if esAdmin();

      match /gastos/{gastoId} {
        allow read, write: if esAdmin();
      }

      match /restocks/{restockId} {
        allow read, write: if esAdmin();
      }
    }

    // ── Pedidos ────────────────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      allow read, write: if esAdmin();
    }

    // Todo lo no declarado arriba queda denegado por defecto.
  }
}
